# Copy this file to .env and fill in real values. .env is gitignored -
# it must never be committed.
#
# These YOUTUBE_* values are only read by scripts/fetch-youtube-playlists.mjs,
# which `npm run build` runs first (the "prebuild" script). They are NOT used by
# the website at runtime, so the key never ships to the browser. In Cloudflare,
# set YOUTUBE_API_KEY under Worker > Settings > Builds > Variables and secrets.
#
# Setup:
#   1. Create/select a project in Google Cloud Console.
#   2. Enable "YouTube Data API v3" for that project.
#   3. Create an API key under APIs & Services > Credentials.
#   4. (Recommended) Restrict the key to "YouTube Data API v3" only.

YOUTUBE_API_KEY=

# Optional - defaults to @pikasfed (see data/site.json) if omitted.
YOUTUBE_CHANNEL_HANDLE=@pikasfed

# Optional - set this to skip the handle lookup if you already know the
# channel's UC... id.
YOUTUBE_CHANNEL_ID=

# Public R2 origin for portfolio photos. Set this locally and in Cloudflare.
PUBLIC_R2_IMAGE_ORIGIN=

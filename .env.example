# Copy this file to .env and fill in real values. .env is gitignored -
# it must never be committed.
#
# This key is only ever read by scripts/fetch_youtube_playlists.py, which you
# run locally (or later from a scheduled CI job). It is NOT used by the
# website itself, so it never ships to the browser - see the comment at the
# top of that script for why.
#
# Setup:
#   1. Create/select a project in Google Cloud Console.
#   2. Enable "YouTube Data API v3" for that project.
#   3. Create an API key under APIs & Services > Credentials.
#   4. (Recommended) Restrict the key to "YouTube Data API v3" only.

YOUTUBE_API_KEY=

# Optional - defaults to @pikasfed (see data/site.json) if omitted.
YOUTUBE_CHANNEL_HANDLE=@pikasfed

# Optional - set this to skip the handle lookup if you already know the
# channel's UC... id.
YOUTUBE_CHANNEL_ID=

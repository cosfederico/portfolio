---
import { Image } from "astro:assets";
import fcLogo from "../assets/fc_logo.png";

// Active-nav highlighting used to be done client-side (fetch header.html,
// inject it, then compare window.location.pathname against each link) -
// Astro.url.pathname gives us the same answer at build time instead, so
// there's no flash of an un-highlighted nav link before JS runs, and no
// runtime fetch for the header at all anymore.
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href) => (href.replace(/\/$/, "") || "/") === currentPath;
---

<header class="site-header">
  <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
  <!-- Only shown (via site.js) on pages that actually render a video background -
       lets visitors stop the looping background clips, for accessibility
       (respects prefers-reduced-motion by default too) and lighter/slower
       browsers. -->
  <button
    class="bg-toggle"
    id="bg-toggle"
    type="button"
    aria-label="Pause background videos"
    aria-pressed="false"
    hidden
  >
    <span class="bg-toggle__icon bg-toggle__icon--pause" aria-hidden="true"></span>
    <span class="bg-toggle__icon bg-toggle__icon--play" aria-hidden="true"></span>
  </button>
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/about/" class:list={{ "is-active": isActive("/about/") }}>About</a>
    <span class="nav-dot" aria-hidden="true">·</span>
    <a href="/photos/" class:list={{ "is-active": isActive("/photos/") }}>Photography</a>
    <span class="nav-dot" aria-hidden="true">·</span>
    <a class="brand-link" href="/" aria-label="Home" class:list={{ "is-active": isActive("/") }}>
      <Image
        src={fcLogo}
        alt="FC"
        loading="eager"
        width={112}
        height={112}
        transition:name="site-logo"
        onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"
      />
      <span class="brand-text" style="display:none">FC</span>
    </a>
    <span class="nav-dot" aria-hidden="true">·</span>
    <a href="/videos/" class:list={{ "is-active": isActive("/videos/") }}>Videos</a>
    <span class="nav-dot" aria-hidden="true">·</span>
    <a href="/contact/" class:list={{ "is-active": isActive("/contact/") }}>Contact</a>
  </nav>
</header>

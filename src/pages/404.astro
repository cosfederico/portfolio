---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import bgImage from "../_resources/images-web/IMG_8638.webp";

const bgFocusY = 55; // vertical crop focal point, 0 = top, 100 = bottom
---

<Layout title="Federico Coscia | Page Not Found" description="This page doesn't exist." bodyClass="fill-viewport" page="404">
  <div class="page-bg" aria-hidden="true">
    <Image src={bgImage} alt="" widths={[800, 1200, 1600]} sizes="100vw" style={`--focus-y: ${bgFocusY}%`} />
  </div>

  <main class="page-shell error-shell" id="main">
    <div class="reveal">
      <p class="eyebrow">Error 404</p>
      <h1>"Rules? There are no rules! We're lost!"</h1>
    </div>

    <div class="error-actions reveal">
      <a class="button" href="/">Back to home</a>
    </div>
  </main>
</Layout>

<style>
  .error-shell {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .error-shell > div:first-child { max-width: 32rem; }

  /* Pinned to the bottom of the shell, centered with margins rather than
     translateX(-50%) - .reveal owns this element's transform. */
  .error-actions {
    position: absolute;
    inset-inline: 0;
    bottom: 3rem;
    width: fit-content;
    margin: 0 auto;
  }
</style>

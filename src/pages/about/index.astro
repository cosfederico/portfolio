---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="About // Federico Coscia"
  description="About Federico Coscia — photographer and filmmaker creating atmospheric visual work."
  bodyClass="about-page"
  page="about"
>
  <div class="about-bg" style="background-image: url('/_resources/images-web/IMG_9725.webp')" aria-hidden="true"></div>
  <div class="home-fade" aria-hidden="true"></div>

  <main class="page-shell about-hero">
    <div class="about-editorial reveal">
      <div class="about-story">
        <div class="about-heading-block">
          <h1>Ciao!</h1>
          <p class="lead">My name is Federico, I'm a photographer and filmmaker. I chase stories, looking for the art and beauty in everyday moments. I bridge the gap between photography and cinema.</p>
        </div>
        <div class="about-copy">
          <p>I'm based in Milan, Italy. If you'd like to work with me, <a class="contact-link" href="/contact">reach out</a>! I'd love to hear your story.</p>
        </div>
      </div>

      <aside class="about-side">
        <div class="about-meta-card">
          <span class="meta-label">Based in</span>
          <strong><a class="position-link" href="https://maps.app.goo.gl/UUEow1nBadCgPjQU9" target="_blank" rel="noopener noreferrer">Milan, Italy</a></strong>
        </div>
        <div class="about-meta-card">
          <span class="meta-label">Available for</span>
          <strong>Music videos, live concerts, shootings, personal projects, and short-form cinematic work.</strong>
        </div>

        <div class="services-list">
          <div class="service-item">
            <h3>Photography</h3>
            <p>Events, travel, and fine art landscapes and portraits</p>
          </div>
          <div class="service-item">
            <h3>Filmmaking</h3>
            <p>Short films, brand stories, and motion studies</p>
          </div>
          <div class="service-item">
            <h3>Commissions</h3>
            <p>Available for collaborations in Italy</p>
          </div>
        </div>
      </aside>
    </div>
  </main>
</Layout>

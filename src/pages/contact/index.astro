---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
// Sourced from src/_resources (gitignored, same convention as public/_resources)
// rather than src/assets - these are delivered content images, not repo
// assets, and will eventually be served from an external store (e.g.
// Cloudflare R2) instead of living in the codebase at all.
import bgImage from "../../_resources/images-web/IMG_0366.webp";

// Vertical crop focal point for the background image below, same convention
// as the 404/videos/about page backgrounds (0 = top of the image, 100 =
// bottom, 50 = centered). Matches the old `background-position: bottom`.
const bgFocusY = 100;
---

<Layout
  title="Contact // Federico Coscia"
  description="Get in touch with Federico Coscia for photography and filmmaking commissions."
  bodyClass="contact-page"
  page="contact"
>
  <div class="contact-bg" aria-hidden="true">
    <Image src={bgImage} alt="" width={1600} height={1067} style={`--focus-y: ${bgFocusY}%`} />
  </div>

  <main class="page-shell">
    <div class="contact-layout">
      <div class="contact-info reveal">
        <h1>Tell me your story.</h1>
        <p class="lead">Available for commissions and creative collaborations.</p>
        <a class="email-link" href="mailto:cosciafederico@outlook.com">cosciafederico@outlook.com</a>
        <p>Based in Milan, Italy. Currently working in Italy.</p>
      </div>

      <form id="contact-form" class="form-card reveal" novalidate>
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" placeholder="Your name" required autocomplete="name" maxlength="20" />
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="Your story" required></textarea>
        </div>
        <button class="button button--filled" type="submit">Send inquiry</button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>

    <div>
      <nav class="social-links" aria-label="Social media">
        <a href="https://instagram.com/pikasfed" target="_blank" rel="noopener noreferrer">Personal Instagram</a>
        <a href="https://instagram.com/federicocosciaphotographer" target="_blank" rel="noopener noreferrer">Events Photography Instagram</a>
        <a href="https://youtube.com/@pikasfed" target="_blank" rel="noopener noreferrer">YouTube</a>
      </nav>
    </div>
  </main>
</Layout>

---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import bgImage from "../../_resources/images-web/IMG_0366.webp";
import site from "../../data/site.json";
import { LIMITS } from "../../lib/contact";

const bgFocusY = 100; // vertical crop focal point, 0 = top, 100 = bottom
---

<Layout
  title="Federico Coscia | Contact"
  description="Get in touch with Federico Coscia for photography and filmmaking commissions."
  bodyClass="fill-viewport"
  page="contact"
>
  <div class="page-bg" aria-hidden="true" style="--bg-opacity: 0.75">
    <Image src={bgImage} alt="" widths={[800, 1200, 1600]} sizes="100vw" style={`--focus-y: ${bgFocusY}%`} />
  </div>

  <main class="page-shell" id="main">
    <div class="contact-layout">
      <div class="contact-info reveal">
        <h1>Tell me your story.</h1>
        <p class="lead">Available for commissions and creative collaborations.</p>
        <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>
        <p>{site.location}</p>
      </div>

      <form id="contact-form" class="form-card reveal" action="/api/contact" method="post">
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" placeholder="Your name" required autocomplete="name" maxlength={LIMITS.name} />
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email" maxlength={LIMITS.email} />
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="Your story" required maxlength={LIMITS.message}></textarea>
        </div>
        <!-- Honeypot: invisible to people, tempting to bots. -->
        <div class="form-honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <button class="button button--filled" type="submit">Send inquiry</button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>

    <nav class="social-links reveal" aria-label="Social media">
      {
        site.social.map(({ label, url }) => (
          <a href={url} target="_blank" rel="noopener noreferrer">
            {label}
          </a>
        ))
      }
    </nav>
  </main>
</Layout>

<script>
  import "../../scripts/contact.js";
</script>

<style>
  .page-shell {
    position: relative;
    z-index: 1;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-info p { margin: 0 0 0.75rem; }

  .email-link {
    display: inline-block;
    margin: 1rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--muted);
    transition: color 0.25s ease, border-color 0.25s ease, filter 0.25s ease;
  }

  .email-link:hover,
  .social-links a:hover {
    color: var(--accent);
    border-color: var(--accent);
    filter: drop-shadow(0 0 5px var(--accent)) drop-shadow(0 0 10px var(--accent));
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }

  .social-links a {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    transition: filter 0.25s ease;
  }

  .form-card {
    display: grid;
    gap: 1rem;
    padding: 2rem;
    border: 1px solid var(--border);
    background: var(--surface);
    backdrop-filter: blur(6px);
  }

  .form-group {
    display: grid;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  input,
  textarea {
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    font: inherit;
    transition: border-color 0.25s ease;
  }

  input:focus,
  textarea:focus {
    border-color: var(--border-strong);
  }

  /* Only after the visitor has interacted, not on a pristine form. */
  input:user-invalid,
  textarea:user-invalid {
    border-color: #ff6b6b;
  }

  textarea {
    resize: vertical;
    min-height: 8.75rem;
  }

  .form-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-status {
    font-size: 0.85rem;
    color: var(--accent);
    margin: 0;
    min-height: 1.25rem;
  }

  .form-status.is-error { color: #ff8a8a; }

  @media (max-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .form-card { padding: 1.25rem; }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import Polaroid from "../components/Polaroid.astro";
import { allPhotos, photoVariants } from "../lib/photos";
import { toJsonIsland } from "../lib/format.js";
import site from "../data/site.json";

// The mosaic's recycling pool (src/scripts/home.js) needs the whole photo list
// client-side, so it ships as an inline JSON island instead of a fetch. Tiles
// get a small `thumb`; the polaroid gets the full-size `src`.
const mosaicJson = toJsonIsland(await Promise.all(allPhotos.map(photoVariants)));
---

<Layout
  title={`${site.name} | Photographer & Filmmaker`}
  description="Cinematic photography and film by Federico Coscia — landscapes, travel, and quiet portraits shaped by light and atmosphere."
  bodyClass="home-page"
  page="home"
  noFooter
>
  <main class="home-hero" id="main">
    <section class="home-mosaic" aria-label="Photo mosaic" aria-hidden="true">
      <div id="home-mosaic-grid" class="home-mosaic-grid" inert></div>
    </section>
    <div class="home-fade" aria-hidden="true"></div>

    <section class="hero-overlay">
      <h1 class="hero-name">FEDERICO COSCIA</h1>
      <p class="hero-role">Photographer &middot; Videomaker</p>
    </section>
  </main>

  <Polaroid />

  <div class="focus-toggle">
    <span class="focus-toggle__glow" aria-hidden="true"></span>
    <span class="focus-toggle__label" id="focus-label">Interactive Mode</span>
    <button type="button" class="focus-toggle__switch" id="focus-switch" role="switch" aria-checked="false" aria-labelledby="focus-label">
      <span class="focus-toggle__knob"></span>
    </button>
  </div>

  <script type="application/json" id="mosaic-data" set:html={mosaicJson} />
  <!-- Inline (and re-run on every visit) so the offset applies before first
       paint. Measures 0 with overlay scrollbars. -->
  <script is:inline data-astro-rerun>
    (() => {
      const probe = document.createElement("div");
      probe.style.cssText = "position:absolute;top:-100px;width:100px;height:10px;overflow:scroll";
      document.body.append(probe);
      document.body.style.setProperty("--scrollbar-width", probe.offsetWidth - probe.clientWidth + "px");
      probe.remove();
    })();
  </script>
</Layout>

<script>
  import "../scripts/home.js";
</script>

<style is:global>
  /* Global: mosaic tiles are created by home.js, outside the reach of scoped
     styles. */
  /* The mosaic scrolls inside its own container, so the page itself never
     does - no page scrollbar, no reserved gutter, full-bleed mosaic. */
  html:has(> body.home-page) {
    overflow: hidden;
    scrollbar-gutter: auto;
  }

  /* Scrolling pages reserve a scrollbar gutter, which centers their header
     in the width left of it. Home has none, so its centered UI is offset by
     half the scrollbar width (measured by the inline script) to line up
     exactly - the hero title and mode toggle too. */
  .home-page .site-header {
    padding-right: calc(var(--gutter) + var(--scrollbar-width, 0px));
  }

  .home-hero {
    position: relative;
    height: 100dvh;
    background: #000;
  }

  .home-mosaic {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .home-mosaic::-webkit-scrollbar { display: none; }

  /* Registered so getComputedStyle() hands home.js a px value. */
  @property --tile-height {
    syntax: "<length>";
    inherits: true;
    initial-value: 200px;
  }

  /* Height (the scrollable space) and every tile's position are set by
     home.js, which only renders the rows near the viewport. */
  .home-mosaic-grid {
    --tile-height: 13.75rem;
    position: relative;
    transition: filter 0.4s ease;
  }

  .mosaic-tile {
    position: absolute;
    overflow: hidden;
    border: 0;
    padding: 0;
    background: #111;
    cursor: default;
    transform: scale(1);
    transition: filter 0.4s ease, transform 0.4s ease;
  }

  .mosaic-tile img {
    opacity: 1;
  }

  .home-mosaic-grid.focus-enabled .mosaic-tile {
    cursor: pointer;
  }

  .mosaic-tile.is-lifted {
    background: #000;
  }

  .mosaic-tile.is-lifted img {
    opacity: 0;
  }

  .home-mosaic-grid.focus-enabled .mosaic-tile:hover,
  .home-mosaic-grid.focus-enabled .mosaic-tile.is-focused {
    filter: brightness(1);
    transform: scale(1.015);
    z-index: 2;
  }

  .home-mosaic-grid.focus-enabled.is-hovering .mosaic-tile {
    filter: brightness(0.6);
  }

  .home-mosaic-grid.focus-enabled.is-hovering .mosaic-tile.is-focused {
    filter: brightness(1) blur(0);
    transform: scale(1.015);
  }

  .hero-overlay {
    position: fixed;
    top: 50%;
    left: calc(50% - var(--scrollbar-width, 0px) / 2); /* see .site-header above */
    transform: translate(-50%, -50%);
    z-index: 2;
    text-align: center;
    pointer-events: none;
    transition: filter 0.6s ease, opacity 0.6s ease;
  }

  body.focus-mode-on .hero-overlay {
    filter: blur(10px);
    opacity: 0;
  }

  .home-fade {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: #000;
    opacity: 0.33;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  body.focus-mode-on .home-fade {
    opacity: 0;
  }

  .focus-toggle {
    position: fixed;
    left: calc(50% - var(--scrollbar-width, 0px) / 2);
    bottom: 2rem;
    z-index: 50;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .focus-toggle__glow {
    position: absolute;
    inset: -28px -50px;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0) 72%);
    filter: blur(18px);
    pointer-events: none;
  }

  .focus-toggle__label {
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
  }

  .focus-toggle__switch {
    position: relative;
    width: 2.875rem;
    height: 1.625rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    transition: background 0.5s ease, border-color 0.5s ease;
  }

  .focus-toggle__switch.is-on {
    background: #fff;
    border-color: #fff;
  }

  .focus-toggle__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1), background 0.5s ease;
  }

  .focus-toggle__switch.is-on .focus-toggle__knob {
    transform: translateX(1.25rem);
    background: #0a0a0a;
  }

  .hero-name {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(2.4rem, 6vw, 4rem); /* floor matches the other pages' h1 */
    letter-spacing: 0.14em;
    color: var(--text);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.65);
  }

  .hero-role {
    margin: 0.75rem 0 0;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-soft);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 768px) {
    .home-mosaic-grid { --tile-height: 9.375rem; }
  }

  @media (max-width: 480px) {
    .home-mosaic-grid { --tile-height: 6.875rem; }
  }
</style>

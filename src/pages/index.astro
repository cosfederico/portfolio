---
import Layout from "../layouts/Layout.astro";
import { allPhotos, photoVariants } from "../lib/photos";
import { toJsonIsland } from "../lib/format.js";
import site from "../data/site.json";

// The mosaic's recycling pool (src/scripts/home.js) needs the whole photo list
// client-side, so it ships as an inline JSON island instead of a fetch. Tiles
// get a small `thumb`; the polaroid gets the full-size `src`.
const mosaicJson = toJsonIsland(await Promise.all(allPhotos.map(photoVariants)));
---

<Layout
  title={`${site.name} | Photographer & Filmmaker`}
  description="Cinematic photography and film by Federico Coscia — landscapes, travel, and quiet portraits shaped by light and atmosphere."
  bodyClass="home-page"
  page="home"
  noFooter
>
  <main class="home-hero" id="main">
    <section class="home-mosaic" aria-label="Photo mosaic" aria-hidden="true">
      <div id="home-mosaic-grid" class="home-mosaic-grid" inert></div>
    </section>
    <div class="home-fade" aria-hidden="true"></div>

    <section class="hero-overlay">
      <h1 class="hero-name">FEDERICO COSCIA</h1>
      <p class="hero-role">Photographer &middot; Videomaker</p>
    </section>
  </main>

  <dialog id="polaroid-modal" class="polaroid-modal" aria-label="Photo details">
    <div class="polaroid-panel">
      <div class="polaroid" id="polaroid">
        <div class="polaroid__card">
          <div class="polaroid__face polaroid__front">
            <div class="polaroid__photo">
              <img id="polaroid-image" alt="" decoding="async" />
            </div>
            <div class="polaroid__caption">
              <p class="polaroid__place" id="polaroid-place"></p>
              <p class="polaroid__date" id="polaroid-date"></p>
              <p class="polaroid__story" id="polaroid-story"></p>
            </div>
          </div>
          <div class="polaroid__face polaroid__back">
            <dl class="polaroid__back-photo polaroid__meta">
              {
                ["Camera", "Aperture", "Shutter", "ISO"].map((label) => (
                  <div class="polaroid__meta-cell">
                    <dt class="polaroid__meta-label">{label}</dt>
                    <dd class="polaroid__meta-value" id={`polaroid-${label.toLowerCase()}`} />
                  </div>
                ))
              }
            </dl>
            <div class="polaroid__back-blank" aria-hidden="true"></div>
          </div>
        </div>
      </div>
      <div class="polaroid-actions">
        <button type="button" class="polaroid-actions__btn polaroid-actions__btn--flip" id="polaroid-flip">Turn over</button>
        <button type="button" class="polaroid-actions__btn polaroid-actions__btn--close" id="polaroid-close">Put back</button>
      </div>
    </div>
  </dialog>

  <div class="focus-toggle">
    <span class="focus-toggle__glow" aria-hidden="true"></span>
    <span class="focus-toggle__label" id="focus-label">Interactive Mode</span>
    <button type="button" class="focus-toggle__switch" id="focus-switch" role="switch" aria-checked="false" aria-labelledby="focus-label">
      <span class="focus-toggle__knob"></span>
    </button>
  </div>

  <script type="application/json" id="mosaic-data" set:html={mosaicJson} />
  <!-- Inline (and re-run on every visit) so the offset applies before first
       paint. Measures 0 with overlay scrollbars. -->
  <script is:inline data-astro-rerun>
    (() => {
      const probe = document.createElement("div");
      probe.style.cssText = "position:absolute;top:-100px;width:100px;height:10px;overflow:scroll";
      document.body.append(probe);
      document.body.style.setProperty("--scrollbar-width", probe.offsetWidth - probe.clientWidth + "px");
      probe.remove();
    })();
  </script>
</Layout>

<script>
  import "../scripts/home.js";
</script>

<style is:global>
  /* Global: mosaic tiles and flight ghosts are created by home.js, outside
     the reach of scoped styles. */
  /* The mosaic scrolls inside its own container, so the page itself never
     does - no page scrollbar, no reserved gutter, full-bleed mosaic. */
  html:has(> body.home-page) {
    overflow: hidden;
    scrollbar-gutter: auto;
  }

  /* Scrolling pages reserve a scrollbar gutter, which centers their header
     in the width left of it. Home has none, so its centered UI is offset by
     half the scrollbar width (measured by the inline script) to line up
     exactly - the hero title and mode toggle too. */
  .home-page .site-header {
    padding-right: calc(var(--gutter) + var(--scrollbar-width, 0px));
  }

  .home-hero {
    position: relative;
    height: 100dvh;
    background: #000;
  }

  .home-mosaic {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .home-mosaic::-webkit-scrollbar { display: none; }

  /* Registered so getComputedStyle() hands home.js a px value. */
  @property --tile-height {
    syntax: "<length>";
    inherits: true;
    initial-value: 200px;
  }

  /* Height (the scrollable space) and every tile's position are set by
     home.js, which only renders the rows near the viewport. */
  .home-mosaic-grid {
    --tile-height: 13.75rem;
    position: relative;
    transition: filter 0.4s ease;
  }

  .mosaic-tile {
    position: absolute;
    overflow: hidden;
    border: 0;
    padding: 0;
    background: #111;
    cursor: default;
    transform: scale(1);
    transition: filter 0.4s ease, transform 0.4s ease;
  }

  .mosaic-tile img {
    opacity: 1;
  }

  .home-mosaic-grid.focus-enabled .mosaic-tile {
    cursor: pointer;
  }

  .mosaic-tile.is-lifted {
    background: #000;
  }

  .mosaic-tile.is-lifted img {
    opacity: 0;
  }

  .home-mosaic-grid.focus-enabled .mosaic-tile:hover,
  .home-mosaic-grid.focus-enabled .mosaic-tile.is-focused {
    filter: brightness(1);
    transform: scale(1.015);
    z-index: 2;
  }

  .home-mosaic-grid.focus-enabled.is-hovering .mosaic-tile {
    filter: brightness(0.6);
  }

  .home-mosaic-grid.focus-enabled.is-hovering .mosaic-tile.is-focused {
    filter: brightness(1) blur(0);
    transform: scale(1.015);
  }

  .hero-overlay {
    position: fixed;
    top: 50%;
    left: calc(50% - var(--scrollbar-width, 0px) / 2); /* see .site-header above */
    transform: translate(-50%, -50%);
    z-index: 2;
    text-align: center;
    pointer-events: none;
    transition: filter 0.6s ease, opacity 0.6s ease;
  }

  body.focus-mode-on .hero-overlay {
    filter: blur(10px);
    opacity: 0;
  }

  .home-fade {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: #000;
    opacity: 0.33;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  body.focus-mode-on .home-fade {
    opacity: 0;
  }

  .focus-toggle {
    position: fixed;
    left: calc(50% - var(--scrollbar-width, 0px) / 2);
    bottom: 2rem;
    z-index: 50;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .focus-toggle__glow {
    position: absolute;
    inset: -28px -50px;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0) 72%);
    filter: blur(18px);
    pointer-events: none;
  }

  .focus-toggle__label {
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
  }

  .focus-toggle__switch {
    position: relative;
    width: 2.875rem;
    height: 1.625rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    transition: background 0.5s ease, border-color 0.5s ease;
  }

  .focus-toggle__switch.is-on {
    background: #fff;
    border-color: #fff;
  }

  .focus-toggle__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1), background 0.5s ease;
  }

  .focus-toggle__switch.is-on .focus-toggle__knob {
    transform: translateX(1.25rem);
    background: #0a0a0a;
  }

  .hero-name {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: 0.14em;
    color: var(--text);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.65);
  }

  .hero-role {
    margin: 0.75rem 0 0;
    font-size: clamp(0.85rem, 1.4vw, 1.1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-soft);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
  }

  /* Single source of truth for the polaroid choreography - home.js reads these
     back at runtime, so tune the animation here only. The *-lead values are
     pure JS scheduling. Units must be ms or s. */
  :root,
  dialog.polaroid-modal::backdrop {
    --polaroid-flight: 500ms; /* photo zoom, mosaic <-> polaroid */
    --polaroid-frame-fade: 300ms; /* frame/caption/actions fade */
    --polaroid-frame-lead: 250ms; /* open: frame fades in this long before the photo lands */
    --polaroid-close-lead: 100ms; /* close: photo leaves this long before the frame finished fading */
    --polaroid-flip: 800ms; /* card turning over */
    --polaroid-ease: cubic-bezier(0.25, 0, 0.25, 1);
    /* The dialog stays painted this long after close() so the return flight
       (which runs inside it) isn't cut off mid-air. */
    --polaroid-keep-alive: calc(var(--polaroid-flight) + 100ms);
  }

  dialog.polaroid-modal {
    /* No display here: the UA display:none for a closed dialog must stay in
       effect, or it lingers as an invisible full-screen layer eating clicks. */
    position: fixed;
    inset: 0;
    z-index: 300;
    margin: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: visible;
    transition: overlay var(--polaroid-keep-alive) allow-discrete, display var(--polaroid-keep-alive) allow-discrete;
  }

  dialog.polaroid-modal[open] {
    display: flex;
  }

  /* Still painted during the keep-alive window after close(); must not eat
     clicks meant for the mosaic. */
  dialog.polaroid-modal:not([open]) {
    pointer-events: none;
  }

  dialog.polaroid-modal::backdrop {
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    transition: background var(--polaroid-flight) var(--polaroid-ease), backdrop-filter var(--polaroid-flight) var(--polaroid-ease),
      overlay var(--polaroid-keep-alive) allow-discrete, display var(--polaroid-keep-alive) allow-discrete;
  }

  dialog.polaroid-modal[open]::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(16px);
  }

  @starting-style {
    dialog.polaroid-modal[open]::backdrop {
      background: rgba(0, 0, 0, 0);
      backdrop-filter: blur(0px);
    }
  }

  /* Width is set per photo by sizePolaroid() in home.js. No geometry
     transition: the flight measures the photo box straight after sizing. */
  .polaroid-panel {
    width: min(23.75rem, 100%);
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .polaroid {
    width: 100%;
    perspective: 2000px;
  }

  /* Frame hidden while the photo ghost flies. Also matched on the ghost: a
     turned card flies home as a clone of the whole card and sheds its frame
     mid-flight using these same rules. */
  :is(.polaroid-panel, .polaroid-flight-ghost).is-chrome-hidden .polaroid__caption,
  :is(.polaroid-panel, .polaroid-flight-ghost).is-chrome-hidden .polaroid-actions {
    opacity: 0;
  }

  .polaroid__caption,
  .polaroid-actions {
    transition: opacity var(--polaroid-frame-fade) ease;
  }

  .polaroid-panel.is-photo-hidden .polaroid__photo img {
    opacity: 0;
  }

  .polaroid-panel.is-card-flying {
    opacity: 0;
  }

  .polaroid-flight-ghost {
    position: fixed;
    top: 0;
    left: 0;
    margin: 0;
    object-fit: cover;
    pointer-events: none;
    z-index: 5;
  }

  .polaroid-flight-ghost--card {
    perspective: 2000px;
  }

  .polaroid-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .polaroid-actions__btn {
    width: 11rem;
    flex: 0 0 auto;
    padding: 0.8rem 1rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    transition: opacity 0.25s ease, background 0.25s ease, color 0.25s ease;
  }

  .polaroid-actions__btn--flip {
    border: none;
    background: #fff;
    color: #0a0a0a;
  }

  .polaroid-actions__btn--flip:hover { opacity: 0.85; }

  .polaroid-actions__btn--close {
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
  }

  .polaroid-actions__btn--close:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .polaroid__card {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
    transition: transform var(--polaroid-flip) cubic-bezier(0.65, 0, 0.35, 1), box-shadow var(--polaroid-frame-fade) ease;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
  }

  .polaroid.is-flipped .polaroid__card {
    transform: rotateY(180deg);
  }

  :is(.polaroid-panel, .polaroid-flight-ghost).is-chrome-hidden .polaroid__card {
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0);
  }

  .polaroid__face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    width: 100%;
    background-color: #f2efe8;
    transition: background-color var(--polaroid-frame-fade) ease;
    padding: 0.9rem 0.9rem 1.4rem;
  }

  :is(.polaroid-panel, .polaroid-flight-ghost).is-chrome-hidden .polaroid__face {
    background-color: transparent;
  }

  .polaroid__front {
    position: relative;
  }

  .polaroid__back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
  }

  .polaroid__back-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0b0b0b;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .polaroid__back-blank {
    flex: 1;
  }

  .polaroid__photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #000;
  }

  .polaroid-panel.is-photo-hidden .polaroid__photo {
    background: transparent;
  }

  .polaroid__photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .polaroid__caption {
    padding-top: 0.9rem;
    text-align: center;
    color: #1a1a1a;
  }

  .polaroid__place {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: #1a1a1a;
  }

  .polaroid__date {
    margin: 0.2rem 0 0;
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  .polaroid__story {
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #3a3a3a;
  }

  .polaroid__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: center;
    margin: 0;
    padding: 0 0.9rem;
  }

  /* Value above its label (dt must come first in the markup). */
  .polaroid__meta-cell {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 0.3rem;
    padding: 0.7rem 0.5rem;
    text-align: center;
  }

  .polaroid__meta-value {
    margin: 0;
    font-size: 1.05rem;
    color: #f2efe8;
  }

  .polaroid__meta-label {
    display: block;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d9c76a;
  }

  @media (max-width: 768px) {
    .home-mosaic-grid { --tile-height: 9.375rem; }
  }

  @media (max-width: 480px) {
    .home-mosaic-grid { --tile-height: 6.875rem; }
  }
</style>

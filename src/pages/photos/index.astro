---
import Layout from "../../layouts/Layout.astro";
import Polaroid from "../../components/Polaroid.astro";
import { allPhotos, imageUrl, photoById, photoVariants } from "../../lib/photos";
import { formatLongDate, toJsonIsland } from "../../lib/format.js";
import data from "../../data/photos.json";
import backgroundPhotos from "../../data/background-photos.json";

const bgImages = backgroundPhotos.map((bg) => ({ ...photoById(bg.id), focusY: bg.focusY }));

// Collections reference photos by id; all photo metadata (EXIF, dates) lives
// in mosaic-items.json, shared with the home page mosaic. Every photo there is
// shown: photos.json lists the ones it puts first, the rest join the
// collection whose years cover their date (slug "2024" or "2017-2019"), or
// the last collection (archive) when there's no match.
const listed = new Set(data.collections.flatMap((c) => c.images));
const collectionFor = (date: string) => {
  const year = Number(date.slice(0, 4));
  return (
    data.collections.find((c) => {
      const [from, to = from] = c.slug.split("-").map(Number);
      return year >= from && year <= to;
    }) ?? data.collections.at(-1)
  );
};
const unlisted = allPhotos.filter((photo) => !listed.has(photo.id));

const collections = await Promise.all(
  data.collections.map(async (collection) => {
    const ids = [...collection.images, ...unlisted.filter((photo) => collectionFor(photo.date) === collection).map((photo) => photo.id)];
    return { ...collection, photos: await Promise.all(ids.map((id) => photoVariants(photoById(id)))) };
  })
);

// The polaroid steps through a collection client-side, so it gets just the
// fields it displays.
const polaroidJson = toJsonIsland(
  Object.fromEntries(
    collections.map((c) => [
      c.slug,
      c.photos.map(({ id, src, alt, aspect, date, place, camera, aperture, shutter, iso }) => ({
        id,
        src,
        alt,
        aspect,
        date,
        place,
        camera,
        aperture,
        shutter,
        iso,
      })),
    ])
  )
);

const coverImage = collections[0]?.photos[0];
---

<Layout
  title="Federico Coscia | Photography"
  description="Photography by Federico Coscia — selected frames of landscapes, travel, people and everyday moments, from 2017 to today."
  page="photos"
>
  <main class="page-shell" id="main">
    <div class="parallax-bg" aria-hidden="true">
      <div id="photos-bg-stack" class="parallax-bg__stack" style="--bg-opacity: 0.3">
        {
          /* No loading="lazy": the parallax moves them into view with a
             transform the lazy loader doesn't track, so some never loaded. */
          bgImages.map((bg) => (
            <img
              src={imageUrl(bg.src)}
              alt=""
              width={bg.width}
              height={bg.height}
              decoding="async"
              style={`--focus-y: ${Number.isFinite(bg.focusY) ? bg.focusY : 50}%`}
            />
          ))
        }
      </div>
    </div>

    <header class="page-header reveal">
      <h1>The photos I'm most proud of.</h1>
    </header>

    <nav class="collection-nav reveal" id="collection-nav" aria-label="Collections">
      <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">All</button>
      {
        collections.map((c) => (
          <button type="button" class="filter-btn" data-filter={c.slug} aria-pressed="false">
            {c.title}
          </button>
        ))
      }
    </nav>

    <div class="collections" id="collections">
      {
        collections.map((c) => (
          <section class="collection" id={c.slug} data-collection={c.slug} aria-labelledby={`${c.slug}-title`}>
            <h2 class="collection__title reveal" id={`${c.slug}-title`}>{c.title}</h2>
            <ul class="collection__grid reveal" role="list">
              {c.photos.map((photo, index) => (
                <li style={`--ar: ${photo.aspect}`}>
                  <button
                    type="button"
                    class="photo-tile"
                    data-collection={c.slug}
                    data-index={index}
                    aria-label={`Open photo ${index + 1} of ${c.photos.length}${photo.date ? `, ${formatLongDate(photo.date)}` : ""}`}
                  >
                    <img
                      src={photo.thumb}
                      alt={photo.alt}
                      width={Math.round(480 * photo.aspect)}
                      height="480"
                      loading={c === collections[0] && index < 4 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <Polaroid>
      <button type="button" class="icon-button polaroid-nav polaroid-nav--prev" id="polaroid-prev" aria-label="Previous photo">&#8592;</button>
      <button type="button" class="icon-button polaroid-nav polaroid-nav--next" id="polaroid-next" aria-label="Next photo">&#8594;</button>
    </Polaroid>

    <script type="application/json" id="photos-data" set:html={polaroidJson} />
  </main>
  {coverImage && <link slot="head" rel="preload" as="image" href={coverImage.thumb} />}
</Layout>

<script>
  import "../../scripts/photos.js";
</script>

<style>
  /* Own stacking context for the .parallax-bg photos (global.css). */
  .page-shell {
    position: relative;
    z-index: 0;
  }

  /* Docked under the header, in its scrolled colour. Solid, not frosted: a
     second backdrop blur over the moving parallax background is redrawn on
     every scroll frame. */
  .collection-nav {
    position: sticky;
    top: var(--header-height);
    z-index: 10;
    display: flex;
    gap: 1rem;
    margin: 0 calc(-1 * var(--gutter)) 2.5rem;
    padding: 0.75rem var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--border);
    background: rgba(8, 8, 8, 0.92);
  }

  .collection-nav::-webkit-scrollbar { display: none; }

  .collections {
    display: grid;
    gap: 3.5rem;
    /* Leaves room for the sticky header + collection nav when jumped to. */
    scroll-margin-top: calc(var(--header-height) + 5rem);
  }

  .collection[hidden] { display: none; }

  .collection__title { margin: 0 0 1rem; }

  /* Justified rows in pure CSS: every item grows in proportion to its aspect
     ratio from a basis of one row height, so all items in a row end up the
     same height and the row spans the full width. The ::after filler soaks
     up the free space of the last row so it isn't stretched. */
  .collection__grid {
    --row-h: 15rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection__grid::after {
    content: "";
    flex: 1e9 1 0;
  }

  .collection__grid li {
    flex: calc(var(--ar) * 100) 1 calc(var(--ar) * var(--row-h));
  }

  .photo-tile {
    display: block;
    width: 100%;
    aspect-ratio: var(--ar);
    padding: 0;
    border: 0;
    overflow: hidden;
    background: #111;
    cursor: zoom-in;
  }

  .photo-tile img {
    transition: transform 0.6s var(--ease-out), opacity 0.4s ease;
  }

  /* Its photo is out in the polaroid. */
  .photo-tile.is-lifted { background: #000; }
  .photo-tile.is-lifted img { visibility: hidden; } /* not opacity: that fades back in after landing */

  @media (hover: hover) {
    .collection__grid:has(.photo-tile:hover) .photo-tile:not(:hover) img { opacity: 0.6; }
    .photo-tile:hover img { transform: scale(1.03); }
  }

  /* ── Polaroid gallery arrows ── */

  :global(.polaroid-panel) { touch-action: pan-y pinch-zoom; } /* horizontal swipes step (photos.js) */

  .polaroid-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    background: rgba(0, 0, 0, 0.35);
    font-size: 1.1rem;
    transition: opacity var(--polaroid-frame-fade) ease, background 0.25s ease, border-color 0.25s ease;
  }

  .polaroid-nav--prev { left: 1.5rem; }
  .polaroid-nav--next { right: 1.5rem; }

  /* They fade with the polaroid's frame, and stay out of the return flight. */
  :global(dialog.polaroid-modal:not([open])) .polaroid-nav,
  :global(dialog.polaroid-modal:has(.polaroid-panel.is-chrome-hidden)) .polaroid-nav {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .collection__grid { --row-h: 6rem; gap: 0.25rem; }

    /* Small enough for every filter to fit across a phone; it still scrolls
       on the narrowest screens. */
    .collection-nav {
      justify-content: space-between;
      gap: 0.15rem;
      padding-block: 0.5rem;
    }

    .filter-btn {
      padding: 0.3rem 0.25rem;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
    }
    .collections { gap: 2.5rem; }

    /* Swipe does the job on touch; keep the arrows out of the photo. */
    .polaroid-nav {
      top: auto;
      bottom: 1.5rem;
      transform: none;
      width: 2.5rem;
      height: 2.5rem;
    }

    .polaroid-nav--prev { left: 1rem; }
    .polaroid-nav--next { right: 1rem; }
  }
</style>

---
import Layout from "../../layouts/Layout.astro";
import PlaylistCard from "../../components/PlaylistCard.astro";
import videos from "../../data/videos.json";
import channelPlaylists from "../../data/youtube-playlists.json";
import backgroundVideos from "../../data/background-videos.json";
import site from "../../data/site.json";
import { wrappedSlice } from "../../lib/wrappedSlice.js";
import { LOOP_BUFFER_CARDS } from "../../lib/constants.js";
import { formatLongDate } from "../../lib/format.js";

const featuredVideo = videos.find((v) => v.featured) ?? videos[0];
const youtubeChannel = site.social.find((s) => s.url.includes("youtube"))?.url;

// One row per playlist, with the clone buffers for the infinite scroll (see
// src/scripts/videos.js) built here once instead of in the browser.
const rows = (channelPlaylists?.playlists ?? []).map((playlist) => {
  const items = playlist.videos;
  const canLoop = items.length >= 2;
  return {
    title: playlist.title,
    videos: items,
    canLoop,
    before: canLoop ? wrappedSlice(items, -LOOP_BUFFER_CARDS, LOOP_BUFFER_CARDS) : [],
    after: canLoop ? wrappedSlice(items, items.length, LOOP_BUFFER_CARDS) : [],
  };
});
---

<Layout
  title="Federico Coscia | Videos"
  description="Cinematic short films and video work by Federico Coscia."
  bodyClass="video-page"
  page="videos"
>
  <Fragment slot="footer-extra">
    <p>
      You can find more on my <a class="youtube-link" href={youtubeChannel} target="_blank" rel="noopener noreferrer">YouTube channel</a>.
    </p>
  </Fragment>

  <main class="page-shell" id="main">
    <div class="video-bg" aria-hidden="true">
      <div id="video-bg-stack" class="video-bg__stack">
        {
          backgroundVideos.map((bg) => (
            <video
              src={bg.src}
              muted
              loop
              playsinline
              preload="metadata"
              disablepictureinpicture
              style={`--focus-y: ${Number.isFinite(bg.focusY) ? bg.focusY : 50}%`}
            />
          ))
        }
      </div>
    </div>

    <header class="page-header reveal">
      <h1>Take a seat with me.</h1>
    </header>

    <section class="video-featured" aria-label="Featured video">
      <div class="video-featured__player reveal">
        {/* Facade: a thumbnail until clicked, so the page doesn't pay for YouTube's player up front. */}
        <button type="button" class="video-facade" id="video-facade" data-video-id={featuredVideo.youtubeId} aria-label={`Play ${featuredVideo.title}`}>
          <img
            src={`https://i.ytimg.com/vi/${featuredVideo.youtubeId}/maxresdefault.jpg`}
            alt=""
            width="1280"
            height="720"
            decoding="async"
            fetchpriority="high"
          />
          <span class="play-icon" aria-hidden="true"></span>
        </button>
      </div>
      <div class="video-featured__info reveal">
        <h2 class="video-featured__title">{featuredVideo.title}</h2>
        <p class="video-featured__date"><time datetime={featuredVideo.date}>{formatLongDate(featuredVideo.date)}</time></p>
        <p class="video-featured__description">{featuredVideo.description}</p>
      </div>
    </section>

    <div class="reveal">
      <h2>Let the credits roll</h2>
    </div>

    <div class="channel-playlists">
      {rows.length === 0 && <p class="empty-state">No playlists yet - run scripts/fetch_youtube_playlists.py to pull them from YouTube.</p>}
      {
        rows.map((row) => (
          <section class="playlist-row reveal" aria-label={row.title}>
            <div class="playlist-row__head">
              <h3 class="playlist-row__title">{row.title}</h3>
              <div class="playlist-row__arrows">
                <button type="button" class="icon-button" data-scroll="-1" aria-label={`Scroll ${row.title} back`}>&#8592;</button>
                <button type="button" class="icon-button" data-scroll="1" aria-label={`Scroll ${row.title} forward`}>&#8594;</button>
              </div>
            </div>
            <div class="playlist-row__scroller" data-loop={String(row.canLoop)} data-real-count={row.videos.length}>
              {row.before.map((video) => <PlaylistCard video={video} isClone />)}
              {row.videos.map((video) => <PlaylistCard video={video} />)}
              {row.after.map((video) => <PlaylistCard video={video} isClone />)}
            </div>
          </section>
        ))
      }
    </div>

    <dialog id="video-modal" class="video-modal modal" aria-labelledby="video-modal-title">
      <div class="video-modal__stage">
        <div id="youtube-player"></div>
      </div>
      <div class="video-modal__footer">
        <h3 class="video-modal__title" id="video-modal-title"></h3>
        <button type="button" class="icon-button" id="video-modal-close" aria-label="Close video">&times;</button>
      </div>
    </dialog>
  </main>
</Layout>

<script>
  import "../../scripts/videos.js";
</script>

<style>
  /* Own stacking context, so .video-bg's negative z-index stays behind this
     page's content without dropping behind the header/footer. */
  .page-shell {
    position: relative;
    z-index: 0;
  }

  /* Default: full-bleed behind the content column, as tall as the content,
     scrolling with the page (videos.js repeats clips to fill that height). */
  .video-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .video-bg__stack {
    --parallax-speed: 0.5; /* 0 = fixed, 1 = scrolls with the page */
    display: flex;
    flex-direction: column;
  }

  /* Parallax: the background becomes a fixed window, and as the page scrolls
     from top to bottom the stack slides up by --parallax-distance (scroll
     range x speed, set by videos.js, which also repeats clips so the stack
     always covers the window). Native scroll-driven animation, so it runs off
     the main thread. Without support, or with reduced motion, the default
     above applies instead. Keep this condition in sync with `parallax` in
     videos.js. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .video-bg {
        position: fixed;
        inset: 0;
        width: auto;
        transform: none;
      }

      .video-bg__stack {
        will-change: transform;
        animation: video-parallax linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes video-parallax {
    to { transform: translateY(calc(-1 * var(--parallax-distance, 0px))); }
  }

  .video-bg__stack video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    /* Per-clip vertical focal point, see "focusY" in background-videos.json. */
    object-position: center var(--focus-y, 50%);
    opacity: 0.45;
  }

  .youtube-link {
    color: rgb(255, 0, 51);
    text-decoration: underline;
    transition: filter 0.25s ease;
  }

  .youtube-link:hover {
    filter: drop-shadow(0 0 5px rgba(255, 0, 51, 0.5)) drop-shadow(0 0 10px rgba(255, 0, 51, 0.25));
  }

  /* One card: the player alone sizes it; the info panel is pinned beside it
     (absolute), so a long description scrolls instead of stretching the
     video. */
  .video-featured {
    position: relative;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    margin-bottom: 3rem;
  }

  .video-featured__player {
    position: relative;
    width: 60%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }

  .video-facade,
  .video-featured__player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-facade {
    display: grid;
    place-items: center;
    padding: 0;
    background: #000;
  }

  .video-facade img {
    position: absolute;
    inset: 0;
    transition: transform 0.6s var(--ease-out), opacity 0.3s ease;
  }

  .video-facade .play-icon {
    position: relative;
    width: 4.5rem;
    height: 4.5rem;
    transition: transform 0.3s var(--ease-out), background 0.3s ease;
  }

  .video-facade:hover img { transform: scale(1.02); opacity: 0.85; }
  .video-facade:hover .play-icon { transform: scale(1.08); background: rgba(0, 0, 0, 0.55); }

  .video-featured__info {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 40%;
    overflow-y: auto;
    padding: 1.5rem;
    border-left: 1px solid var(--border);
  }

  .video-featured__title {
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.15;
    margin: 0 0 0.6rem;
  }

  .video-featured__date {
    margin: 0 0 1rem;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .video-featured__description {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.7;
    white-space: pre-line; /* descriptions contain literal line breaks */
  }

  /* ── Playlist rows ── */

  .channel-playlists {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .playlist-row__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .playlist-row__title { margin: 0; }

  .playlist-row__arrows {
    display: flex;
    gap: 0.5rem;
  }

  .playlist-row__arrows[hidden] { display: none; }

  /* Touch users swipe; arrows are for mouse and keyboard. */
  @media (hover: none) {
    .playlist-row__arrows { display: none; }
  }

  .playlist-row__scroller {
    display: flex;
    /* Horizontal only: vertical wheel/swipes over a strip scroll the page. */
    overflow: auto hidden;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    /* Full-bleed: the strip spans the viewport, the title stays in the column. */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .playlist-row__scroller::-webkit-scrollbar { display: none; }

  /* ── Video modal ── */

  dialog.video-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    margin: auto;
    width: min(60rem, calc(100% - 4rem));
    max-width: none;
    max-height: calc(100dvh - 4rem);
    border: 1px solid var(--border);
    padding: 0;
    background: var(--bg-elevated);
    color: inherit;
    overflow: visible;
    opacity: 0;
    transform: translateY(16px) scale(0.97);
    transition: opacity 0.45s var(--ease-out), transform 0.45s var(--ease-out), overlay 0.45s allow-discrete,
      display 0.45s allow-discrete;
  }

  dialog.video-modal[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    dialog.video-modal[open] {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }

  .video-modal__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  /* The YouTube API replaces #youtube-player with its own iframe. */
  .video-modal__stage :global(#youtube-player) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .video-modal__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border);
  }

  .video-modal__title {
    margin: 0;
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    dialog.video-modal { width: calc(100% - 2rem); }

    /* Stacked: the info panel back in flow at its natural height. */
    .video-featured__player { width: 100%; }

    .video-featured__info {
      position: static;
      width: 100%;
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
